{% extends 'base.html.twig' %}

{% block title %}Live dashboard{% endblock %}

{% block body %}
    <main class="container py-4 py-lg-5">
        <nav class="d-flex justify-content-between align-items-center mb-5" aria-label="Main navigation">
            <a class="brand text-decoration-none" href="{{ path('plug_index') }}">⌁ Homemon</a>
            <form method="post" action="{{ path('app_logout') }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                <button class="btn btn-outline-secondary btn-sm" type="submit">Sign out</button>
            </form>
        </nav>
        {{ component('PlugDashboard') }}
    </main>
{% endblock %}
