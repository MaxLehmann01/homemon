{% extends 'base.html.twig' %}

{% block title %}{{ is_edit ? 'Plug bearbeiten' : 'Plug hinzufügen' }}{% endblock %}

{% block body %}
    <main class="container py-5">
        <a class="back-link text-decoration-none small" href="{{ path('plug_index') }}">← Zurück zu allen Plugs</a>
        <div class="form-card mx-auto mt-4 p-4 p-sm-5 rounded-4">
            <p class="text-uppercase text-primary fw-semibold small mb-2">Plug-Verwaltung</p>
            <h1 class="h3 mb-2">{{ is_edit ? 'Plug bearbeiten' : 'Neuen Plug hinzufügen' }}</h1>
            <p class="text-secondary mb-4">{{ is_edit ? 'Passe Namen oder Verbindungsadresse an.' : 'Trage einen Namen und die lokale Adresse deines Shelly Plugs ein.' }}</p>

            {{ form_start(form, {attr: {class: 'plug-form'}}) }}
                {{ form_row(form.name, {row_attr: {class: 'mb-3'}, attr: {class: 'form-control'}}) }}
                {{ form_row(form.hostname, {row_attr: {class: 'mb-4'}, attr: {class: 'form-control'}}) }}
                <div class="d-flex flex-column-reverse flex-sm-row gap-2">
                    <a class="btn btn-light" href="{{ path('plug_index') }}">Abbrechen</a>
                    {{ form_widget(form.save) }}
                </div>
            {{ form_end(form) }}
        </div>
    </main>
{% endblock %}
